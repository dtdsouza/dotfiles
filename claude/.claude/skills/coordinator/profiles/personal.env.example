# Copy to ~/.config/agentctl/profiles/personal.env. agentctl.sh sources it (bash), and the dashboard
# reads the same KEY=value lines; keep values to plain paths, ~ and $HOME.
AGENTCTL_LABEL=Personal
COORDINATOR_STATE_DIR=$HOME/workspace/github/.claude/coordinator
COORDINATOR_DEFAULT_REPO=$HOME/workspace/github
AGENTCTL_SESSION=personal
AGENTCTL_HARNESS=codex
AGENTCTL_ALLOWED_HARNESSES=codex
AGENTCTL_MODEL=gpt-6.1-sol
AGENTCTL_COORDINATOR_MODEL=gpt-6.1-sol
# Artifacts only: augments dashboard defaults unless the server sets explicit global roots/off.
AGENTCTL_FILE_ROOTS="$HOME/workspace/github/**/.claude/tmp/**:$HOME/workspace/github/**/.claude/worktrees/*/{.claude/tmp,docs,openspec}/**"
# Colon-separated; spawn refuses any repo or cwd under these.
AGENTCTL_DENY_ROOTS=$HOME/workspace/twism
# An allowlist: env vars whose names don't match are removed from the profile's tmux session and
# from every Codex it starts, so a new secret in the work shell can't leak by default.
AGENTCTL_KEEP_ENV='^(HOME|USER|LOGNAME|SHELL|PATH|PWD|OLDPWD|SHLVL|HOSTNAME|LANG|LANGUAGE|LC_[A-Z]+|TZ|TERM|COLORTERM|TERM_PROGRAM|TERM_PROGRAM_VERSION|TMUX|TMUX_PANE|DISPLAY|WAYLAND_DISPLAY|XAUTHORITY|XDG_[A-Z_]+|DBUS_SESSION_BUS_ADDRESS|SSH_AUTH_SOCK|EDITOR|VISUAL|GIT_EDITOR|PAGER|LESS|NVM_[A-Z_]+|NODE_OPTIONS|CODEX_HOME|AGENT_PROFILE|AGENTCTL_[A-Z_]+|COORDINATOR_[A-Z_]+)$'
